{
  "name": "dsh-agents-manager",
  "version": "0.5.0",
  "description": "AI enhancement plugin for DeepSeek Harness, split into five toggleable bundle rows (插件详情页逐行启停，每行带中文名): core skeleton + MCP & skills management (MCP servers, skills, per-session capability selection, settings pages, testing) + subagent roles & model pools + automatic model-request retry (provider policies, vendor-expression rules, cross-restart monitor) + per-session process panel with auto-detection and report_service_process.",
  "license": "MIT",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "mcp",
    "skills",
    "subagents",
    "retry"
  ],
  "type": "module",
  "main": "src/host/index.js",
  "exports": {
    ".": "./src/host/index.js",
    "./client": "./client/client.js",
    "./capabilities": "./src/host/features/capabilities.js",
    "./subagents": "./src/host/features/subagents.js",
    "./retry": "./src/host/features/retry.js",
    "./processes": "./src/host/features/processes.js",
    "./capabilities/locale/*.json": "./locale/capabilities/*.json",
    "./subagents/locale/*.json": "./locale/subagents/*.json",
    "./retry/locale/*.json": "./locale/retry/*.json",
    "./processes/locale/*.json": "./locale/processes/*.json",
    "./capabilities/icon": "./icon.svg",
    "./subagents/icon": "./icon.svg",
    "./retry/icon": "./icon.svg",
    "./processes/icon": "./icon.svg",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "client",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.2.0",
    "zod": "^4.4.3"
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.1-rc.5 <0.3.0"
  },
  "scripts": {
    "test": "node --test 'test/**/*.test.mjs'"
  },
  "devDependencies": {
    "react": "18.3.1",
    "react-test-renderer": "18.3.1"
  }
}
